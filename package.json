{
  "name": "gf2-gacha-tool",
  "version": "2.3.0-beta.46",
  "description": "少女前線2：追放 抽卡統計工具",
  "main": "main.js",
  "author": "LiaoSAM",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "data:items": "node tools/generateItemMap.js",
    "test:overview": "node tests/overview-stats.test.js && node tests/overview-ui-contract.test.js && node tests/recruitment-analysis-ui.test.js && node tests/progress-ui-v12.test.js && node tests/external-acquisitions.test.js && node tests/character-art-assets.test.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "protobufjs": "8.6.6"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gf2.gacha.tool",
    "productName": "GF2 Gacha Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "itemMap.json",
      "signatureMap.json",
      "characterArtMap.json",
      "weaponArtMap.json",
      "outfitPoolMap.json",
      "poolMap.generated.json",
      "data-update-manifest.json",
      "package.json",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
